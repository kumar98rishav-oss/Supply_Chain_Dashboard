	measure 'Revenue YoY % (vs PY)' =
			
			VAR _y = YEAR(DATE("2024","12","31"))
			VAR _cur = CALCULATE ( [Revenue], REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = _y )
			VAR _py = CALCULATE ( [Revenue], REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = _y - 1 )
			RETURN
			    DIVIDE ( _cur - _py, _py )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligeance
		lineageTag: f78167e0-defe-4568-ae21-0a37cefe5962

	measure 'Revenue YoY Color' = IF ( [Revenue YoY % (vs PY)] >= 0, "#2E9E6B", "#D64545" )
