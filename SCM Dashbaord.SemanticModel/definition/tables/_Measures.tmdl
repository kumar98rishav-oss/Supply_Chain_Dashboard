	measure 'PL Anchor Year' =
			YEAR (
			    CALCULATE (
			        MAX ( Fact_Sales[OrderDate] ),
			        REMOVEFILTERS ( Dim_Warehouse ),
			        REMOVEFILTERS ( Dim_Product ),
			        REMOVEFILTERS ( Dim_Customer )
			    )
			)
		formatString: 0
		displayFolder: 07 Supply Chain P&L
		lineageTag: 38797ffd-c142-4190-8484-7a3cc3113037

	measure 'PL Period Label' =
			VAR y = [PL Anchor Year]
			RETURN y & " - " & ( y - 1 )
		displayFolder: 07 Supply Chain P&L
		lineageTag: 8938ca3b-a2b2-4979-89f6-538ea5366aac

	measure 'PL Amount' =
			VAR lineId = SELECTEDVALUE ( 'PL Lines'[LineID] )
			VAR gross = [Gross Sales (List Price)]
			VAR disc = [Total Discount Value]
			VAR netrev = [Revenue]
			VAR cogs = [Total COGS]
			VAR gp = [Gross_Profit]
			VAR frt = [Freight Cost]
			VAR ppv = [PPV (Purchase Price Variance)]
			RETURN
			    SWITCH (
			        lineId,
			        1, gross,
			        2, -disc,
			        3, netrev,
			        4, -cogs,
			        5, gp,
			        6, -frt,
			        7, -ppv,
			        8, gp - frt - ppv
			    )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: 07 Supply Chain P&L
		lineageTag: 9189cc69-7ce8-465a-b976-0a1af563fc71

	measure 'PL CY' =
			VAR y = [PL Anchor Year]
			RETURN CALCULATE ( [PL Amount], Dim_Date[Year] = y )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: 07 Supply Chain P&L
		lineageTag: 83fc5007-ae24-4aad-b00a-ce14c2861f15

	measure 'PL PY' =
			
			VAR y = [PL Anchor Year]
			RETURN CALCULATE ( [PL Amount], Dim_Date[Year] = y - 1 )
		formatString: \$#,0;(\$#,0);\$0
		displayFolder: 07 Supply Chain P&L
		lineageTag: f6b43405-11c7-4c32-9ab6-a4883dcc8f60

	measure 'PL Var' = [PL CY] - [PL PY]
		formatString: +\$#,0;-\$#,0;\$0
		displayFolder: 07 Supply Chain P&L
		lineageTag: 0d1f3510-46c2-4e07-ad34-d2bdc939e068

	measure 'PL Var %' =
			
			VAR cy = [PL CY]
			VAR py = [PL PY]
			RETURN
			DIVIDE ( cy - py, ABS ( py ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 07 Supply Chain P&L
		lineageTag: 7c7acd30-b0e3-4052-ac29-b3b486d8e540

	measure 'PL % of Net Revenue' =
			IF (
