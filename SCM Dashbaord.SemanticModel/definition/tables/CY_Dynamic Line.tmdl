	column 'CY_Dynamic Line Order'
		isHidden
		formatString: 0
		lineageTag: ee8abe36-fda4-4214-ba42-6bcbb2688aed
		summarizeBy: sum
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	partition 'CY_Dynamic Line' = calculated
		mode: import
		source =
				{
				    ("Revenue", NAMEOF('_Measures'[Revenue]), 0),
				    ("OTIF%", NAMEOF('_Measures'[OTIF%]), 1),
				    ("In_full %", NAMEOF('_Measures'[In_full %]), 2),
				    ("On_Time %", NAMEOF('_Measures'[On_Time %]), 3)
				}

	annotation PBI_Id = 09b4977f328041afbe9d3cca67de26d1

